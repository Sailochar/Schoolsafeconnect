{
  "env": {
    "node": true,
    "es2022": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "commonjs"
  },
  "rules": {
    "no-console": "warn",
    "no-unused-vars": "error",
    "eqeqeq": "error",
    "curly": "error",
    "semi": "error",
    "quotes": ["error", "double"],
    "indent": ["error", 2],
    "no-trailing-spaces": "error",
    "no-multiple-empty-lines": "error"
  }
}
